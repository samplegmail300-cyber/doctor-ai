# Copy this file to  .env  (same folder as app.py) and paste your NEW keys.
# NEVER commit the real .env file or share these keys.

# Text chat (fast, free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Image + scanned report analysis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional backup provider: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: change models without editing code
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
